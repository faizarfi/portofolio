# Base URL untuk metadata OpenGraph, canonical, dan sitemap
NEXT_PUBLIC_SITE_URL=https://faizarfianilhami.caitlyn.my.id

# Cloudflare Turnstile (diisi key dari Cloudflare Dashboard; tambahkan localhost untuk testing lokal)
# Untuk test lokal tanpa domain terdaftar, Cloudflare menyediakan dummy key:
# NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# CLOUDFLARE_TURNSTILE_SECRET=1x0000000000000000000000000000000AA
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET=

# Opsional: kirim email langsung dari /api/contact via Resend tanpa mengandalkan mailto:
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=Portofolio <onboarding@resend.dev>
# CONTACT_TO_EMAIL=faizarfianilhami020204@gmail.com

# Opsional: notifikasi pesan langsung ke Telegram Bot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

